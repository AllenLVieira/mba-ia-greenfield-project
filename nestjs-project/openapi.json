  "info": {
    "title": "StreamTube API",
    "description": "API REST do StreamTube",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "access-token": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {}
      },
      "ResendConfirmationDto": {
        "type": "object",
        "properties": {}
      },
      "LoginDto": {
        "type": "object",
        "properties": {}
      },
      "RefreshTokenDto": {
        "type": "object",
        "properties": {}
      },
      "ForgotPasswordDto": {
        "type": "object",
        "properties": {}
      },
      "ResetPasswordDto": {
        "type": "object",
        "properties": {}
      },
      "InitiateUploadDto": {
        "type": "object",
        "properties": {}
      },
      "InitiateUploadResponseDto": {
        "type": "object",
        "properties": {
          "uploadId": {
            "type": "string",
            "description": "The S3 UploadId for the opened multipart upload"
          },
          "key": {
            "type": "string",
            "description": "The videoId-addressed ingest object key chosen by the API"
          },
          "publicSlug": {
            "type": "string",
            "description": "The 11-char public handle used by every subsequent video route"
          }
        },
        "required": [
          "uploadId",
          "key",
          "publicSlug"
        ]
      },
      "SignPartResponseDto": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "description": "Presigned UploadPart URL, signed for the browser"
          },
          "headers": {
            "type": "object",
            "description": "Headers the client must replay on the PUT",
            "additionalProperties": {
              "type": "string"
            }
          }
        },
        "required": [
          "url",
          "headers"
        ]
      },
      "CompleteUploadDto": {
        "type": "object",
        "properties": {}
      },
      "CompleteUploadResponseDto": {
        "type": "object",
        "properties": {
          "location": {
            "type": "string",
            "description": "The completed object location"
          }
        },
        "required": [
          "location"
        ]
      },
      "ProcessingErrorDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "example": "NO_VIDEO_STREAM"
          },
          "message": {
            "type": "string",
            "example": "The uploaded object contains no video stream"
          }
        },
        "required": [
          "code",
          "message"
        ]
      },
      "VideoStatusResponseDto": {
        "type": "object",
        "properties": {
          "publicSlug": {
            "type": "string",
            "description": "The 11-char public handle for this video"
          },
          "title": {
            "type": "string"
          },
          "processingStatus": {
            "type": "string",
            "enum": [
              "PENDING_UPLOAD",
              "UPLOADING",
              "PROCESSING",
              "READY",
              "FAILED"
            ]
          },
          "processingError": {
            "nullable": true,
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/ProcessingErrorDto"
              }
            ]
          },
          "durationSeconds": {
            "type": "object",
            "nullable": true
          },
          "width": {
            "type": "object",
            "nullable": true
          },
          "height": {
            "type": "object",
            "nullable": true
          },
          "sizeBytes": {
            "type": "string",
            "description": "Declared and reconciled object size, in bytes"
          },
          "container": {
            "type": "object",
            "nullable": true
          },
          "videoCodec": {
            "type": "object",
            "nullable": true
          },
          "audioCodec": {
            "type": "object",
            "nullable": true
          }
        },
        "required": [
          "publicSlug",
          "title",
          "processingStatus",
          "sizeBytes"
        ]
      },
      "PresignedUrlResponseDto": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "description": "Presigned GetObject URL against the media bucket"
          },
          "expiresIn": {
            "type": "number",
            "description": "TTL of the presigned URL, in seconds"
          }
        },
        "required": [
          "url",
          "expiresIn"
        ]
      },
      "ApiErrorEnvelope": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "number",
            "example": 401
          },
          "error": {
            "type": "string",
            "example": "INVALID_CREDENTIALS"
          },
          "message": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ],
            "example": "Invalid email or password"
          },
          "code": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "statusCode",
          "error",
          "message"
        ]
      }
    }
  }
}