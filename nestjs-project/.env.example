# Application
NODE_ENV=development
PORT=3000

# Database (PostgreSQL)
DB_HOST=db
DB_PORT=5432
DB_USERNAME=streamtube
DB_PASSWORD=streamtube
DB_NAME=streamtube

# JWT
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-refresh-in-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
CONFIRMATION_TOKEN_EXPIRATION_HOURS=1
PASSWORD_RESET_TOKEN_EXPIRATION_HOURS=1

# Mail (Mailpit for local development)
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM="StreamTube" <noreply@streamtube.com>

# Object storage (MinIO for local development)
# Internal endpoint = Compose service name, used for server-side I/O.
# Public endpoint = published host, used to sign URLs the browser can reach.
STORAGE_INTERNAL_ENDPOINT=http://minio:9000
STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY_ID=streamtube
STORAGE_SECRET_ACCESS_KEY=streamtube
STORAGE_UPLOADS_BUCKET=streamtube-uploads
STORAGE_MEDIA_BUCKET=streamtube-media
STORAGE_PRESIGN_TTL_SECONDS=3600
